# Firebase Web configuration for the trekking and blog content collections.
# Public pages use the built-in hardcoded content if Firebase is unavailable.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ImageKit API keys from Developer options > API keys.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Optional comma-separated allowlists. If omitted, every manually created Firebase Auth user can upload.
IMAGEKIT_ADMIN_UIDS=
IMAGEKIT_ADMIN_EMAILS=
