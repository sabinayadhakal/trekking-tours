rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /trekkingServices/{trekId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /freeTours/{tourId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /multiDayTours/{tourId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /dayHikings/{hikingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /daySightseeings/{tourId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /mountainFlights/{flightId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /jungleSafaris/{safariId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinationTours/{tourId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
